MONGODB_URI=mongodb+srv://<kullanici>:<sifre>@<cluster>.mongodb.net/ilanla?retryWrites=true&w=majority
PORT=3000
NODE_ENV=development
# Browser: macos-brave | macos-chrome | windows-chrome | windows-brave | linux-chrome | linux-brave
BROWSER_PLATFORM=macos-brave
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
IMGBB_API_KEY=
GROQ_API_KEY=
# Yayın logu klasörü (opsiyonel, varsayılan: data/publish-log)
PUBLISH_LOG_DIR=
